# kaniko and docker read .dockerignore from the build context root, and the
# frontend is its own context (the Jenkinsfile's
# helmCharts.kaniko("frontend/Dockerfile", "frontend", ...) call). The repo-root
# .dockerignore does not apply here.
#
# node_modules matters for correctness, not just speed: the Dockerfile runs
# pnpm install and then COPY . ., so an uploaded host node_modules would
# overwrite the freshly installed one. dist is likewise regenerated by the
# image's own pnpm build.
.git
.pnpm-store
node_modules
test-results
playwright-report
dist
.claude
logs
