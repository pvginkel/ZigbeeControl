// Validates ZigbeeControl's hand-authored architecture models, backend/docs/architecture/*.yaml and
// frontend/docs/architecture/*.yaml, against the architecture service, and archives them as the
// producer's artifact, which AaC/Architecture collects.
//
// The monorepo is one producer, zigbee-control: both models declare it, and AaC/Architecture
// collects them together as that producer's artifact.
//
// Controller config:
//   - Job: AaC/ZigbeeControl
//   - SCM: pvginkel/ZigbeeControl, branch main
//   - Script Path: Jenkinsfile.architecture

library identifier: 'JenkinsPipelineUtils', changelog: false

pipeline {
    agent {
        kubernetes {
            inheritFrom 'jenkins-agent'
            yaml podYaml(templates: ['aac-tools'])
        }
    }

    options {
        disableConcurrentBuilds(abortPrevious: true)
        skipDefaultCheckout()
        timeout(time: 60, unit: 'MINUTES')
        timestamps()
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate architecture (backend)') {
            steps {
                script {
                    architectureProducer.validate(files: ['backend/docs/architecture/*.yaml'])
                    architectureProducer.archive(files: ['backend/docs/architecture/*.yaml'])
                }
            }
        }

        stage('Validate architecture (frontend)') {
            steps {
                script {
                    architectureProducer.validate(files: ['frontend/docs/architecture/*.yaml'])
                    architectureProducer.archive(files: ['frontend/docs/architecture/*.yaml'])
                }
            }
        }
    }
}
